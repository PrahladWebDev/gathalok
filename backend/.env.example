# Copy this file to .env and fill in the real values.
# backend/.env is gitignored — it is never committed.

# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://gathalok.prahladsingh.in

# ─── Database ───────────────────────────────────────────
MONGODB_URI=

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=30d

# ─── Cloudinary (image uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (verification + password reset) ───────────────
# Gmail: use an App Password for SMTP_PASS, not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification
# must be enabled on the account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=prahlad.singh.dev@gmail.com
SMTP_PASS=
SMTP_FROM_NAME=GathaLok
